<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>EasyGameTranslator</AssemblyName>
    <Version>0.1.0-beta</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <InformationalVersion>EasyGameTranslator 0.1 Beta</InformationalVersion>
    <Authors>VaporWaveXReal</Authors>
    <Description>Экранный переводчик английского текста для игр и приложений Windows.</Description>
    <RepositoryUrl>https://github.com/VaporWaveXReal/EasyGameTranslator</RepositoryUrl>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="smoke\**\*.cs" />
    <Compile Remove="PaddleOcrClient.cs" />
    <PackageReference Include="GTranslate" Version="2.2.8" />
    <PackageReference Include="SharpDX.Direct3D11" Version="4.2.0" />
    <PackageReference Include="SharpDX.DXGI" Version="4.2.0" />
  </ItemGroup>
</Project>
